{
  "name": "ecotrack",
  "version": "1.0.0",
  "description": "EcoTrack – Sistema de gestió de residus industrials. Projecte final DAW/DAM.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "preview": "npx http-server -p 8080 dist/ecotrack/browser",
    "cap:init": "npx cap init EcoTrack com.ecosolutions.ecotrack --web-dir dist/ecotrack/browser",
    "cap:android": "npx cap add android",
    "cap:sync": "ng build && npx cap copy",
    "cap:open": "npx cap open android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@angular/service-worker": "^18.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "typescript": "~5.4.2"
  }
}
